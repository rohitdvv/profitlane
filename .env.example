# Optional: enables natural-language query parsing + LLM-written explanations.
# Without it, the app falls back to deterministic parsing + a deterministic summary.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# PROFITLANE_MODEL=claude-sonnet-5-5

# Optional: path to the folder containing loads_part_*.txt
# LOADS_DATA_DIR=./data

# --- Business ---
# PROFITLANE_DB=./profitlane.db
# Enables /admin/metrics and /admin/grant (send header X-Admin-Token)
# PROFITLANE_ADMIN_TOKEN=change-me-long-random
# Set to true when serving over HTTPS
# PROFITLANE_COOKIE_SECURE=true

# Stripe Payment Links (dashboard -> Payment Links, recurring price). Without these,
# "Upgrade" captures a lead instead and you can grant plans via /admin/grant.
# STRIPE_LINK_PRO_URL=https://buy.stripe.com/...
# STRIPE_LINK_PRO_ID=plink_...
# STRIPE_LINK_FLEET_URL=https://buy.stripe.com/...
# STRIPE_LINK_FLEET_ID=plink_...
# Webhook -> https://<your-host>/api/stripe/webhook
#   events: checkout.session.completed, customer.subscription.deleted
# STRIPE_WEBHOOK_SECRET=whsec_...

# Partner referral links (a CTA appears on the #1 pick only when set)
# PARTNER_FACTORING_URL=https://...your-referral-link...
# PARTNER_FUEL_URL=https://...your-referral-link...
# FUEL_DISCOUNT_PER_GALLON=0.25
